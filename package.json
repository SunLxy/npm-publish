{
  "name": "npm-publish",
  "version": "1.0.3",
  "description": "npm publish",
  "main": "src/main.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:dist": "rolldown ./src/action/index.ts --dir=dist --platform=node --treeshake --sourcemap",
    "all": "npm run build && npm run build:dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/typescript-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "files": [
    "src",
    "lib"
  ],
  "author": "SunLxy <1011771396@qq.com>",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.9.1",
    "@jsdevtools/npm-publish": "^4.1.1",
    "fast-glob": "^3.2.11",
    "pacote": "^15.1.1"
  },
  "devDependencies": {
    "rolldown": "1.0.0-beta.54",
    "@types/pacote": "^11.1.5",
    "@types/semver": "^7.7.1",
    "@types/node": "^25.0.1",
    "js-yaml": "^4.1.0",
    "prettier": "2.7.1",
    "typescript": "^5.9.3"
  }
}